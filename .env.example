# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# AUD prices (existing) — $79 Pro / $149 Ultra
VITE_STRIPE_PRO_PRICE_ID=price_...
VITE_STRIPE_ULTRA_PRICE_ID=price_...

# USD prices (multi-currency pricing) — $59 Pro / $79 Ultra, one-time,
# attached to the SAME Stripe products as the AUD prices above (create via
# `stripe prices create --product <same product id> --currency usd
# --unit-amount 5900`, etc.) — never a separate product. Read by
# api/_lib/planPricing.js for tier + currency resolution. Optional: if
# unset, USD checkout sessions simply can't be created (resolvePlanFromPriceId
# returns null for a USD priceId, same as any other unrecognised price) —
# AUD-only behaviour is unaffected either way.
VITE_STRIPE_PRO_PRICE_ID_USD=price_...
VITE_STRIPE_ULTRA_PRICE_ID_USD=price_...

# Base44
VITE_BASE44_APP_ID=...

# Base44 admin API key — server-only, NEVER exposed to the browser. Used by
# api/webhooks/stripe.js (api/_lib/base44Admin.js) to write User.plan on a
# verified Stripe payment — the only path that can write the built-in User
# entity from a server context (the base44.entities.* client SDK explicitly
# cannot bulk-update User records).
BASE44_ADMIN_KEY=...

# Google Places API — server-side proxy only (api/places.js, api/places-search.js,
# api/places-photo.js). Powers Experience Guide/Accommodation/Transport local
# recommendations. Get a key at https://console.cloud.google.com → APIs &
# Services → Credentials. Enable: Places API (Legacy) or Places API (New).
# Add to Vercel: Dashboard → Settings → Environment Variables → GOOGLE_PLACES_API_KEY
#
# NEVER add a VITE_GOOGLE_* client-side key — it would be bundled into the
# browser JS. The client calls our own /api/places* proxy, never Google
# directly (fixed in PR #263 — an earlier VITE_GOOGLE_MAPS_API_KEY existed
# here and should not come back).
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Resend (email) — transactional + alert email, sent from hello@openinvite.com.au
RESEND_API_KEY=re_...

# Stripe webhook — verifies api/webhooks/stripe.js signatures. Required
# (fails closed) in production; optional locally if testing without
# `stripe listen --forward-to`.
STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel Cron auth — Vercel injects this automatically in production for its
# own scheduled invocations of api/cron/*.js. Every cron endpoint fails
# closed (401) in production if this is unset, so it must be set for the
# crons to run at all in prod. Not required locally (crons just skip auth
# with a warning when unset outside production).
CRON_SECRET=...

# Cloudflare Turnstile — bot-gates the anonymous guest-write endpoints
# (RSVP, poll votes, guest contact form, etc). Get keys at
# https://dash.cloudflare.com → Turnstile.
VITE_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# Spotify — server-side proxy (api/spotify-*.js) for playlist/track search
# and OAuth. VITE_SPOTIFY_CLIENT_ID is the public client id used for the
# OAuth authorize redirect (not a secret); SPOTIFY_CLIENT_SECRET stays
# server-only.
VITE_SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_ID=...
SPOTIFY_CLIENT_SECRET=...

# Pexels API — server-only, powers the "Stock photos" tab in
# MediaLibraryModal.jsx via api/stock-search.js. NEVER add a VITE_ prefix —
# it would ship in the client bundle. Free tier: 200 requests/hour.
# Get a key at https://www.pexels.com/api/ (instant, no approval wait)
# Add to Vercel: Dashboard → Settings → Environment Variables → PEXELS_API_KEY
PEXELS_API_KEY=your_pexels_api_key_here

# Sentry — error monitoring + session replay. VITE_SENTRY_DSN is public
# (client-side init); SENTRY_AUTH_TOKEN is build-time only, used to upload
# source maps and is never bundled into the browser.
VITE_SENTRY_DSN=https://...
SENTRY_AUTH_TOKEN=sntrys_...

# PostHog — product analytics. Both safe to leave unset locally (analytics.js
# no-ops when VITE_POSTHOG_KEY is missing).
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Canonical app URL — used in email templates/links (e.g. Spotify OAuth
# redirect fallback, purchase confirmation emails).
VITE_APP_URL=https://openinvite.com.au

# Local-only: dedicated test account for npm run test:persistence /
# npm run reset:test. Not a real customer account — gitignored, never set
# in Vercel.
BASE44_TEST_EMAIL=...
BASE44_TEST_PASSWORD=...
