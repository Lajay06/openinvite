#!/bin/sh
# Pre-push gates. Each must exit 0 or the push is refused.
#
# 1. PAYMENTS FREEZE — the only files in this repo where a mistake costs the
#    owner money. It ran first for a reason: a lint failure is an
#    inconvenience, a payments change is a liability.
# 3. LINT — a probe was once committed with two no-undef errors and pushed,
#    and CI caught it. That is the gate catching an omission rather than the
#    author checking their own work.
#
# --no-verify skips BOTH of these, which is exactly why the payments check also
# runs in CI, where it cannot be skipped. Never leave a critical guard behind
# the same switch as a convenience one: skipping lint is what a tired person
# does at midnight, and a shared bypass makes that careless act carry the
# dangerous one.
node scripts/check-payments-freeze.mjs || exit 1
# 1b. CREDENTIALS — a session storage-state and a live RSVP token were staged
#    into a commit by `git add -A`, DESPITE both being in .gitignore. The rules
#    covering them were added on 2026-08-25; a recovery branch created at a
#    2026-07-16 base checked out a .gitignore that predated them, and every
#    ignored hazard in the working directory became stageable again.
#    .gitignore protection is only as old as the commit you stand on. This
#    check does not consult it.
node scripts/check-no-credentials.mjs || exit 1
# 2. CANON ON A BRANCH — the standing-rules files have been destroyed twice by
#    being written on a branch and then reset away. They belong on main, where
#    a docs-only commit needs no branch and has nothing to lose.
node scripts/check-canon-branch.mjs || exit 1
# 2b. THE DOCS CHANNEL CARRIES ONLY DOCS — the other half of the same hole the
#    canon guard covers one end of. Canon must reach main without a PR, so a
#    direct-to-main route exists; nothing checked that it carried only what it
#    was named for. On 2026-09-05 a `git add -A` pushed src/lib/sampleContent/
#    havana.js onto main under a commit titled "docs: D-READ" — product code
#    with no PR, no CI and no review. Pairs with ship.sh's untracked-file
#    refusal (R24): that stops the staging, this stops the landing.
node scripts/check-docs-only-on-main.mjs || exit 1
exec npm run lint
