{
  "name": "CollaboratorSuggestion",
  "type": "object",
  "properties": {
    "owner_user_id_hash": {
      "type": "string",
      "description": "HMAC-SHA256(BASE44_ADMIN_KEY, owner's real Base44 User.id). Hashed rather than raw because read:null makes this entity listable by anyone holding any API token \u2014 computing a matching hash for a chosen id needs BASE44_ADMIN_KEY, which callers do not have, so a forged row can never target a real owner."
    },
    "collaborator_user_id_hash": {
      "type": "string",
      "description": "HMAC-SHA256(BASE44_ADMIN_KEY, collaborator's real Base44 User.id) \u2014 same construction and reasoning as owner_user_id_hash. Same value as the matching field on CollaboratorGrant and CollaboratorInvite, so a suggestion can be joined to the grant it belongs to without any record holding the raw user id."
    },
    "page": {
      "type": "string",
      "description": "The page key the suggestion is about (matching the keys in collaboratorPageMap.js), e.g. 'Guests' or 'Budget'."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "suggest",
        "approve",
        "decline"
      ],
      "description": "Append-only event log, same pattern as CollaboratorGrant: a collaborator raises 'suggest', and the owner's 'approve' or 'decline' settles it. Latest event per suggestion_id wins at read time; rows are never mutated."
    },
    "suggestion_id": {
      "type": "string",
      "description": "Stable id grouping the events of one suggestion. Optional."
    },
    "payload_enc": {
      "type": "string",
      "description": "AES-256-GCM ciphertext (base64, iv+authTag+ciphertext) of the suggestion's own content. Key derived from BASE44_ADMIN_KEY, same construction as CollaboratorGrant.owner_id_enc. Optional."
    },
    "is_test": {
      "type": "boolean",
      "default": false,
      "description": "Set by scripts/test-persistence.mjs on every record it creates. Product queries must exclude is_test records so test-harness data can never surface in real dashboards, even if harness cleanup fails."
    }
  },
  "required": [
    "owner_user_id_hash",
    "collaborator_user_id_hash",
    "page",
    "event_type"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}