{
  "name": "Note",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "description": {
      "type": "string",
      "description": "Task description"
    },
    "category": {
      "type": "string",
      "enum": [
        "venue",
        "catering",
        "attire",
        "photography",
        "flowers",
        "music",
        "transportation",
        "legal",
        "guests",
        "decorations",
        "general"
      ],
      "default": "general",
      "description": "Task category"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Priority level"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the task is completed"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Due date for the task"
    },
    "reminder_date": {
      "type": "string",
      "format": "date-time",
      "description": "When to send a reminder"
    },
    "is_suggested": {
      "type": "boolean",
      "default": false,
      "description": "Whether this was an AI suggestion"
    },
    "wedding_timeline": {
      "type": "string",
      "enum": [
        "12_months",
        "9_months",
        "6_months",
        "3_months",
        "1_month",
        "2_weeks",
        "1_week",
        "day_of"
      ],
      "description": "When this task should typically be done"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ideas",
        "In progress",
        "Done"
      ],
      "default": "Ideas",
      "description": "Kanban column, stored as the display label from KANBAN_COLS in src/pages/TodoList.jsx. Declared 2026-08-18: previously undeclared, so writes were dropped and reads withheld, which emptied the todo list (schema-scanner refresh, #483). App-defined fixed set, so an enum is correct here — but Base44 does NOT enforce enums on write (gotcha #20: an out-of-set value stores with HTTP 200), so this documents intent rather than constraining it. Adding a column means widening this enum via the advisor AND updating KANBAN_COLS."
    },
    "view_type": {
      "type": "string",
      "enum": [
        "todo"
      ],
      "default": "todo",
      "description": "Partition tag, NOT a view mode: marks a Note as a todo-list item. TodoList.jsx loads with filter(n => n.view_type === 'todo') and writes the literal 'todo' on every create. Declared 2026-08-18 alongside status, same defect. A row without it is invisible to the todo list, so the default matters."
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}