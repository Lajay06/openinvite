{
  "name": "RsvpResponse",
  "type": "object",
  "properties": {
    "wedding_id": { "type": "string", "description": "WeddingDetails id this response belongs to. Kept plaintext deliberately — not PII on its own, and the couple's own dashboard read needs to filter by it directly. Confirmed no dedup/identity key anywhere in the codebase uses wedding_id (see src/lib/rsvpAggregation.js's dedupKey), so leaving it unhashed doesn't weaken guest_id_hash/encrypted_guest_level's protection." },
    "guest_id_hash": { "type": "string", "description": "HMAC-SHA256(BASE44_ADMIN_KEY, guest.id) — read:null means this entity is listable unscoped by anyone with any API token (confirmed empirically 2026-08-03: an unauthenticated request returned all 2010+ rows across 472 weddings), so the plaintext Guest.id never lives here. Server endpoints compute the same deterministic hash to filter/match (api/_lib/questionnaireCrypto.js hashId — same construction as QuestionnaireResponse.guest_id_hash). The primary guest and their plus-one share the same underlying guest_id_hash (there is no separate Guest record for a plus-one) — is_plus_one is what distinguishes their rows, never guest_id_hash. Renamed from the plaintext `guest_id` this entity used to carry (fix/rsvp-response-encryption, PR 1a) — see BASE44_PLATFORM_NOTES.md's PII-exposure section for why." },
    "event_id": { "type": "string", "description": "Stable event id from WeddingDetails' preWeddingEvents[]/postWeddingEvents[]/mainCeremony/reception this response is for. NULL marks this row as the whole-submission guest-level row (encrypted_guest_level) — a row is either a per-event row (event_id set, status/meal_choice/plus_ones/plus_one_names populated) or a guest-level row (event_id null, encrypted_guest_level populated); never both on the same row." },
    "status": { "type": "string", "enum": ["pending", "yes", "no"], "default": "pending", "description": "Attendance response for this event. Only ever set on a per-event row (event_id non-null)." },
    "meal_choice": { "type": "string", "description": "Menu option id/label for this event, null if not yet chosen. Only ever set on a per-event row." },
    "plus_ones": { "type": "number", "description": "Count of plus-ones granted/used for this event. Only ever set on a per-event row." },
    "plus_one_names": { "type": "array", "items": { "type": "string" }, "description": "Names of plus-ones attending this event. Only ever set on a per-event row." },
    "encrypted_guest_level": { "type": "string", "description": "AES-256-GCM ciphertext (base64, iv+authTag+ciphertext) of {song_request, note, dietary_restrictions, email} — key derived from BASE44_ADMIN_KEY, same api/_lib/questionnaireCrypto.js encryptPayload()/decryptPayload() construction as QuestionnaireResponse.encrypted_answers. Decryptable only server-side; an unscoped list of this entity yields opaque blobs, never plaintext song requests/dietary needs/notes/email. Only ever set on the guest-level row (event_id null). Replaces the plaintext note/song_request/dietary_restrictions/email fields this entity used to carry (fix/rsvp-response-encryption, PR 1a)." },
    "is_test": { "type": "boolean", "default": false, "description": "Set by scripts/test-persistence.mjs on every record it creates. Product queries must exclude is_test records so test-harness data can never surface in real dashboards, even if harness cleanup fails." },
    "is_plus_one": { "type": "boolean", "default": false, "description": "True when this row is the plus-one's own submission (via their own plus_one_rsvp_link_id token), false/unset for the primary guest's own row. Combined with guest_id_hash + event_id as the dedup key (src/lib/rsvpAggregation.js) so a plus-one's answers can never overwrite or be overwritten by the primary guest's — existing rows all default to false, so old data's dedup behaviour is unchanged." }
  },
  "required": [],
  "rls": { "create": null, "read": null, "update": { "created_by_id": "{{user.id}}" }, "delete": { "created_by_id": "{{user.id}}" } }
}
