{
  "name": "SongRequest",
  "type": "object",
  "properties": {
    "weddingId": {
      "type": "string"
    },
    "spotifyTrackId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "album": {
      "type": "string"
    },
    "albumArt": {
      "type": "string"
    },
    "duration": {
      "type": "number"
    },
    "explicit": {
      "type": "boolean",
      "default": false
    },
    "spotifyUrl": {
      "type": "string"
    },
    "submittedBy": {
      "type": "string"
    },
    "guestEmailHash": {
      "type": "string",
      "description": "HMAC-SHA256 of the guest's email (api/_lib/questionnaireCrypto.js hashId) — used only for the limitOnePerGuest dedup equality check, never decrypted or displayed. Replaces the old plaintext guestEmail field (fix/song-request-email-hash)."
    },
    "guestNote": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined",
        "added"
      ],
      "default": "pending"
    },
    "playlist": {
      "type": "string",
      "default": "general"
    },
    "aiTags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mustPlay": {
      "type": "boolean",
      "default": false
    },
    "doNotPlay": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "artist",
    "submittedBy"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}