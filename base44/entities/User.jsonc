{
  "name": "User",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "default": "en",
      "description": "User's preferred language code (e.g., en, es, fr)"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "User's preferred currency code (e.g., USD, EUR, GBP)"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed the onboarding process"
    },
    "tempUnit": {
      "type": "string",
      "enum": ["C", "F"],
      "default": "C",
      "description": "Preferred temperature unit for the wedding-day weather banner"
    },
    "deletionRequestedAt": {
      "type": "string",
      "description": "ISO timestamp set when the user submits an in-app account deletion request (see DataDeletion.jsx policy) — actual deletion is manual, verified via hello@openinvite.com.au"
    },
    "trialStartedAt": {
      "type": "string",
      "description": "ISO timestamp written when the user chooses the free trial on ChoosePlan.jsx (goFree). Marks when the 14-day trial clock actually starts — Layout.jsx's trial banner reads this, falling back to created_date only when absent (pre-existing accounts from before this field existed)."
    },
    "notification_prefs": {
      "type": "object",
      "description": "Per-user notification channel preferences, read by the bell UI and the event-wiring/digest cron. Defaults applied client-side when absent (pre-existing accounts): instant_email_rsvp=true, instant_email_collaborator=true, weekly_digest=true, in_app_only=false. In-app notifications themselves are never fully disableable — in_app_only=true suppresses instant emails and the digest, keeping only the bell.",
      "properties": {
        "instant_email_rsvp": { "type": "boolean", "default": true },
        "instant_email_collaborator": { "type": "boolean", "default": true },
        "weekly_digest": { "type": "boolean", "default": true },
        "in_app_only": { "type": "boolean", "default": false }
      }
    },
    "dateFormat": {
      "type": "string",
      "enum": ["dmy", "mdy"],
      "default": "dmy",
      "description": "Which numeric date format the DASHBOARD renders dates in: dmy is 18/05/2026, mdy is 05/18/2026. Guest-facing pages and every email keep their written dates (\"18 May 2026\") and never read this. Added live by the owner 2026-10-08 for item 5 of goals/2026-10-08-site-fixes-batch-1.md; the default means every existing account keeps the behaviour it had with no backfill."
    }
  },
  "required": []
}