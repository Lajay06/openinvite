{
  "name": "Vendor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Vendor business name"
    },
    "category": {
      "type": "string",
      "enum": [
        "venue",
        "catering",
        "photography",
        "videography",
        "flowers",
        "music",
        "bakery",
        "transportation",
        "beauty",
        "attire",
        "planning",
        "decorations",
        "entertainment",
        "other"
      ],
      "description": "Type of vendor service"
    },
    "contact_person": {
      "type": "string",
      "description": "Primary contact person name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "website": {
      "type": "string",
      "format": "uri",
      "description": "Website URL"
    },
    "address": {
      "type": "string",
      "description": "Business address"
    },
    "latitude": {
      "type": "number",
      "description": "GPS latitude"
    },
    "longitude": {
      "type": "number",
      "description": "GPS longitude"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating out of 5"
    },
    "price_range": {
      "type": "string",
      "enum": [
        "$",
        "$$",
        "$$$",
        "$$$$"
      ],
      "description": "Price range indicator"
    },
    "status": {
      "type": "string",
      "enum": [
        "researching",
        "contacted",
        "meeting_scheduled",
        "quoted",
        "booked",
        "rejected"
      ],
      "default": "researching",
      "description": "Current status with vendor"
    },
    "quoted_price": {
      "type": "number",
      "description": "Quoted price from vendor"
    },
    "contract_date": {
      "type": "string",
      "format": "date",
      "description": "Date contract was signed"
    },
    "payment_schedule": {
      "type": "string",
      "description": "Payment terms and schedule"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about vendor"
    },
    "google_place_id": {
      "type": "string",
      "description": "Google Places API place ID"
    },
    "google_rating": {
      "type": "number",
      "description": "Google rating"
    },
    "google_reviews_count": {
      "type": "number",
      "description": "Number of Google reviews"
    },
    "image_url": {
      "type": "string",
      "format": "uri",
      "description": "Main image URL"
    },
    "is_favourite": {
      "type": "boolean",
      "default": false,
      "description": "Owner has starred this vendor as a favourite"
    },
    "instagram": {
      "type": "string",
      "description": "Instagram handle"
    },
    "reviews_count": {
      "type": "number",
      "description": "Number of reviews (not necessarily Google-sourced — see google_reviews_count for that)"
    },
    "starting_price": {
      "type": "number",
      "description": "Starting package price"
    },
    "package_selected": {
      "type": "string",
      "description": "Selected package name"
    },
    "hours_booked": {
      "type": "number",
      "description": "Number of hours booked"
    },
    "booking_date": {
      "type": "string",
      "format": "date",
      "description": "Date of service (distinct from contract_date, when the contract was signed)"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (e.g., 14:00)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (e.g., 22:00)"
    },
    "meeting_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date/time of meeting or consultation"
    },
    "contract_signed": {
      "type": "boolean",
      "default": false,
      "description": "Whether contract has been signed"
    },
    "deposit_paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether deposit has been paid"
    },
    "deposit_amount": {
      "type": "number",
      "description": "Deposit amount"
    },
    "style": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "candid",
          "traditional",
          "artistic",
          "documentary",
          "cinematic",
          "vintage",
          "modern",
          "natural"
        ]
      },
      "description": "Photography/videography style (photography/videography category only)"
    },
    "portfolio_url": {
      "type": "string",
      "format": "uri",
      "description": "Portfolio website URL"
    },
    "sample_work": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "Sample image URLs"
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of services (e.g., engagement shoot, albums, prints). Also used to record a secondary service a single vendor covers that doesn't fit the single-value category field — e.g. a photographer who also shoots video gets category:'photography' with 'videography' added here, rather than a second Vendor record."
    },
    "equipment": {
      "type": "string",
      "description": "Camera equipment and gear used (photography/videography category only)"
    },
    "backup_equipment": {
      "type": "boolean",
      "default": false,
      "description": "Has backup equipment (photography/videography category only)"
    },
    "second_shooter": {
      "type": "boolean",
      "default": false,
      "description": "Includes second shooter (photography/videography category only)"
    },
    "delivery_timeline": {
      "type": "string",
      "description": "Photo/video delivery timeline (e.g., 4-6 weeks)"
    },
    "image_count": {
      "type": "number",
      "description": "Number of edited images included (photography category only)"
    },
    "video_length": {
      "type": "string",
      "description": "Video length (e.g., 3-5 minutes highlight reel) (videography category only)"
    },
    "editing_style": {
      "type": "string",
      "description": "Editing style description (photography/videography category only)"
    },
    "travel_fee": {
      "type": "number",
      "description": "Travel fee if applicable"
    },
    "cancellation_policy": {
      "type": "string",
      "description": "Cancellation policy details"
    },
    "special_requests": {
      "type": "string",
      "description": "Special requests or must-have shots (distinct from the general-purpose notes field)"
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}