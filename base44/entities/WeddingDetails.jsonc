      "type": "string"
    },
    "transportNotes": {
      "type": "string"
    },
    "accommodationNotes": {
      "type": "string"
    },
    // Step 2a: ciphertext at rest. This mirror said "object" until Step 2b —
    // live has been "string" since #436. Drift, now corrected.
    "contactPerson": {
      "type": "string",
      "description": "AES-256-GCM ciphertext (api/_lib/questionnaireCrypto.js) of the original {name, phone} object, fix/weddingdetails-field-encryption Step 2a. No known writer in the app (verified via repo-wide grep) — encrypted at rest defensively regardless, which is also why no row has ever held a plaintext value. Decrypted server-side only, by api/my-wedding-details.js's GET. Mixed rows are handled by that endpoint's typeof-string discriminator; there is no backfill and none is needed (see scratchpad/DECISION-LOG.md, Step 2a closed as already-satisfied)."
    },
    "preWeddingEvents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "postWeddingEvents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "qna": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "slug": {
      "type": "string"
    },
    "websiteEnabled": {
      "type": "boolean",
      "default": false
    },
    "websitePassword": {
      "type": "string",
      "description": "scrypt hash of the public wedding site's gate credential, format scrypt$<saltHex>$<digestHex> (api/_lib/websitePasswordHash.js), Step 2b stage (iii). A HASH, not ciphertext: every other sensitive field here is AES-256-GCM because the couple must read it back, but this one is only ever asked 'does this candidate match?', so it is never recoverable. Written and verified only via api/my-wedding-details.js / api/wedding-by-slug.js; NEVER returned to the client — the GET exposes a websitePasswordIsSet boolean instead. The scrypt$ prefix is the migrated-vs-legacy discriminator, because unlike the encrypted fields the legacy plaintext here is itself a string, so the typeof-string test used elsewhere cannot work here. Per-value random salt, so two couples choosing the same password do not share a digest. NOT the on/off switch — see websitePasswordEnabled."
    },
    // Declared live 2026-08-17. PublishModal.jsx had been writing this since
    // it shipped and Base44 silently dropped it every time (undeclared field,
    // canonical gotcha #5) — the toggle appeared to work and forgot on reload.
    "websitePasswordEnabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the public wedding site requires a password. The single source of truth for the gate being ON — websitePassword holds the credential and must not be used to infer enabled/disabled. Written by the Publish modal / Share tab / builder right panel, all via src/lib/websitePasswordGate.js. Gate fails OPEN if enabled=true with no stored credential (logged loudly by api/wedding-by-slug.js; the UI refuses to save that state, so it is unreachable through normal use). Reasoning in scratchpad/DECISION-LOG.md."
    },
