    // Step 2b: ciphertext at rest. Original shape kept in the description
    // rather than in `properties`, because the stored value is now a string.
    "celebrant": {
      "type": "string",
      "description": "AES-256-GCM ciphertext (api/_lib/questionnaireCrypto.js) of the original {name, title, phone, email, type, notes} object, fix/weddingdetails-field-encryption Step 2b. Written only via api/my-wedding-details.js (PUT) by src/pages/CeremonyDetails.jsx, which no longer writes this field directly. Decrypted server-side only, by that same endpoint's GET. Mixed rows are expected and permanent: legacy plaintext rows are still objects and pass through that endpoint's typeof-string discriminator untouched. There is no backfill — a row converts to ciphertext the first time CeremonyDetails saves it."
    },
    // Step 2b: ciphertext at rest — see the celebrant note above.
    "license": {
      "type": "string",
      "description": "AES-256-GCM ciphertext (api/_lib/questionnaireCrypto.js) of the original {issuingOffice, applicationDate, issueDate, expiryDate, licenseNumber, witnessesRequired, notes} object, fix/weddingdetails-field-encryption Step 2b. Written only via api/my-wedding-details.js (PUT) by src/pages/CeremonyDetails.jsx. Decrypted server-side only, by that same endpoint's GET. Mixed rows are expected and permanent: legacy plaintext rows are still objects and pass through that endpoint's typeof-string discriminator untouched. There is no backfill — a row converts to ciphertext the first time CeremonyDetails saves it."
    },
