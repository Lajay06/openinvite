    "emergencyContacts": {
      "type": "string",
      "description": "AES-256-GCM ciphertext (api/_lib/questionnaireCrypto.js) of the original wedding-day emergency contacts {primary, backup, venue, otherNotes} object, fix/weddingdetails-field-encryption Step 2b. Written only via api/my-wedding-details.js (PUT) by src/pages/EmergencyContact.jsx, which no longer writes this field directly. Decrypted server-side only, by that same endpoint's GET. Never returned to a guest — also listed in NEVER_RETURN_FIELDS in api/_lib/guestSafeWedding.js. Mixed rows are expected and permanent: legacy plaintext rows are still objects and pass through that endpoint's typeof-string discriminator untouched. There is no backfill — a row converts to ciphertext the first time EmergencyContact saves it."
    },
    // Step 2b: ciphertext at rest. Note this one's legacy plaintext shape is
    // an ARRAY, not an object — still not a string, so the same
    // typeof-string discriminator holds.
    "dayVendorContacts": {
      "type": "string",
      "description": "AES-256-GCM ciphertext (api/_lib/questionnaireCrypto.js) of the original key-vendor-contacts array of {name, phone, role} objects, fix/weddingdetails-field-encryption Step 2b. Written only via api/my-wedding-details.js (PUT) by src/pages/EmergencyContact.jsx, which no longer writes this field directly. Decrypted server-side only, by that same endpoint's GET. Never returned to a guest — also listed in NEVER_RETURN_FIELDS in api/_lib/guestSafeWedding.js. Mixed rows are expected and permanent: legacy plaintext rows are still arrays and pass through that endpoint's typeof-string discriminator untouched. There is no backfill — a row converts to ciphertext the first time EmergencyContact saves it."
    },
